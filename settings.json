{
    "teacher_password": "12345",
    
    "file_monitoring": {
        "enabled": true,
        "monitor_all_drives": true,
        "folders": [
            "Desktop",
            "Documents",
            "Downloads"
        ],
        "excluded_folders": [
            "C:\\Temp",
            "C:\\$Recycle.Bin"
        ],
        "excluded_extensions": [
            ".tmp",
            ".temp",
            ".log",
            ".part",
            ".crdownload"
        ]
    },
    
    "browser_monitoring": {
        "enabled": true,
        "browsers": [
            "chrome.exe",
            "msedge.exe",
            "firefox.exe",
            "opera.exe",
            "yandex.exe",
            "brave.exe"
        ],
        "check_interval_seconds": 5
    },
    
    "install_guard": {
        "enabled": true,
        "installer_keywords": [
            "setup",
            "install",
            "installer",
            "msiexec",
            "uninstall"
        ]
    }
}